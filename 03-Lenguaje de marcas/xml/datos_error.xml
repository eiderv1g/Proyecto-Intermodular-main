  ERROR 2 (línea ~35): dificultad="extreme" no está en la enumeración (easy|medium|hard)
  ERROR 3 (línea ~47): empleado="e99" apunta a un ID que no existe (IDREF inválido)
-->

<cyberforge>
    <alumnos>
        <alumno id="a1" telefono="600123123">
