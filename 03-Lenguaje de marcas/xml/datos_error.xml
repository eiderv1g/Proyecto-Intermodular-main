        <empleado id="e1" rol="hacker" salario="2000" fecha_contratacion="2024-01-01" departamento="d1">
            <nombre>Carlos Ruiz</nombre>
            <email>carlos@empresa.com</email>
        </empleado>
    </empleados>
    <laboratorios>
        <!-- ERROR 2: dificultad "extreme" no existe en la enumeración del DTD -->
